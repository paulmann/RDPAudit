<Project Sdk="Microsoft.NET.Sdk.Worker">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>RdpAudit.Service</RootNamespace>
		<AssemblyName>RdpAudit.Service</AssemblyName>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks> 
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
		<PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
		<PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
		<PackageReference Include="MessagePack" Version="2.5.307" />
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\RdpAudit.Core\RdpAudit.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Embedded copy of the committed OpenAPI descriptor served at /openapi/v1.json. -->
		<EmbeddedResource Include="RestApi\openapi-v1.json" LogicalName="RdpAudit.Service.RestApi.openapi-v1.json" />
	</ItemGroup>
	<ItemGroup>
		<!--
			RdpAudit.Service.Tests drives the internal retention engine directly (AfterBatchCommitted).

			RdpAudit.StorageBenchmarks does the same on purpose: the storage benchmark under tools/ measures
			through the REAL retention engine rather than a reimplementation, so its published numbers
			describe the code that actually runs in production. It is a developer tool and never ships in a
			product artifact.
		-->
		<InternalsVisibleTo Include="RdpAudit.Service.Tests" />
		<InternalsVisibleTo Include="RdpAudit.StorageBenchmarks" />
	</ItemGroup>
</Project>
